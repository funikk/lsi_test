# Yosys Pre-Synthesis Fast Check Script
# Rapidly detects multiple drivers, unmapped cells, and latch/async-reset anomalies in seconds.

read_verilog -sv ../rtl/aes_sbox.v
read_verilog -sv ../rtl/aes_core.v
read_verilog -sv ../rtl/lfsr_prng_ctrl.v
read_verilog -sv ../rtl/aes_dma_subsys.v
read_verilog -sv ../rtl/picorv32.v
read_verilog -sv ../rtl/cpu_aes_prng_core.v

hierarchy -top cpu_aes_prng_core
proc
check -assert
opt_clean
