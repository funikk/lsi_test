## ==============================================================================
## VDRV_v2 IEEE 1801 UPF Power Specification: Footer Switch (NMOS) Implementation
## Design: VDRV_v2_core
## Power Domain Architecture:
##   - PD_TOP : Always-On (AON) default power domain (CPU, UART, Sequencer, Power Mgr)
##   - PD_AES : Power-gated domain for AES-128 Core & LFSR PRNG
## Switch Architecture:
##   - Footer Switch (NMOS) between permanent VSS and virtual VSS_V
## ==============================================================================

upf_version 2.0

## -----------------------------------------------------------------------------
## 1. Power Domains Definition
## -----------------------------------------------------------------------------
# Top-level Always-On (AON) power domain
create_power_domain PD_TOP -include_scope

# Power-gated domain containing AES Core and PRNG
create_power_domain PD_AES -elements {u_aes_dma/u_aes_prng_pd}

## -----------------------------------------------------------------------------
## 2. Supply Ports & Supply Nets
## -----------------------------------------------------------------------------
# Top-level primary power and ground ports
create_supply_port VDD -direction in
create_supply_port VSS -direction in

# Supply nets in PD_TOP domain
create_supply_net VDD -domain PD_TOP
create_supply_net VSS -domain PD_TOP

# Connect supply ports to supply nets in PD_TOP
connect_supply_net VDD -ports {VDD}
connect_supply_net VSS -ports {VSS}

# Supply nets in PD_AES domain
# VDD is shared with PD_TOP (Common Power)
create_supply_net VDD   -domain PD_AES -reuse
# Virtual VSS (VSS_V) is switched by Footer Power Switch
create_supply_net VSS_V -domain PD_AES

## -----------------------------------------------------------------------------
## 3. Domain Primary Supply Connections
## -----------------------------------------------------------------------------
set_domain_supply_net PD_TOP \
    -primary_power_net VDD \
    -primary_ground_net VSS

set_domain_supply_net PD_AES \
    -primary_power_net VDD \
    -primary_ground_net VSS_V

## -----------------------------------------------------------------------------
## 4. Power Switch Specification (Footer Switch / NMOS)
## -----------------------------------------------------------------------------
# Footer switch connects permanent VSS to virtual VSS_V.
# Controlled by active-high 'pd_aes_on' (1: Power ON, 0: Power OFF).
# When pd_aes_on = 1, NMOS switch turns ON and pulls VSS_V to VSS ground.
create_power_switch PSW_FOOTER_PD_AES \
    -domain PD_AES \
    -input_supply_port  {in_vss VSS} \
    -output_supply_port {out_vss_v VSS_V} \
    -control_port       {ctrl_en pd_aes_on} \
    -on_state           {ON_STATE in_vss {ctrl_en}}

## -----------------------------------------------------------------------------
## 5. Isolation Strategy
## -----------------------------------------------------------------------------
# Isolate outputs of PD_AES to prevent floating/X-propagation to PD_TOP when PD_AES is OFF.
# Clamped to Low (0) matching aes_isolation.v specification.
# Isolation cells are powered from AON domain (VDD / VSS).
set_isolation ISO_PD_AES \
    -domain PD_AES \
    -isolation_power_net VDD \
    -isolation_ground_net VSS \
    -clamp_value 0 \
    -applies_to outputs

set_isolation_control ISO_PD_AES \
    -domain PD_AES \
    -isolation_signal aes_isolate \
    -isolation_sense high \
    -location parent

## -----------------------------------------------------------------------------
## 6. Power State Table (PST) Definition
## -----------------------------------------------------------------------------
add_port_state VDD -state {ON 1.80}
add_port_state VSS -state {GND 0.00}
add_port_state PSW_FOOTER_PD_AES/out_vss_v \
    -state {GND 0.00} \
    -state {OFF off}

create_pst PST_VDRV -supplies {VDD VSS PSW_FOOTER_PD_AES/out_vss_v}

# Normal operation: Both PD_TOP and PD_AES powered ON (VSS_V pulled to GND)
add_pst_state ALL_ON  -pst PST_VDRV -state {ON GND GND}

# Power-gated state: PD_TOP is ON, PD_AES footer is open (VSS_V is floating/OFF)
add_pst_state AES_OFF -pst PST_VDRV -state {ON GND OFF}
