# ==========================================
# 1. EDAツール本体・PDKs・環境設定 (管理対象外)
# ==========================================
/librelane/
/pdks/
/.tools/

# ==========================================
# 2. PnR (LibreLane) 実行結果
# ==========================================
# librelane_designs 内の config.json 等の設定ファイルは管理対象にし、
# 実行成果物が格納される runs/ ディレクトリを除外
librelane_designs/**/runs/

# ==========================================
# 3. 各プロジェクトのビルド・シミュレーション生成物
# ==========================================
# 波形・ログ・コンパイル済みバイナリ・中間成果物
*.vcd
*.vvp
*.log
*.out

# sim/, syn/, gls/ ディレクトリ内の動的生成物
*/sim/*.vcd
*/sim/*.out
*/sim/*.log
*/sim/*_sim
*/gls/*.vcd
*/gls/*.out
*/gls/*.log
*/gls/*_gls
*/syn/*.log
*/syn/*.json
*/syn/*_syn.v

# ==========================================
# 4. ファームウェアビルド生成物
# ==========================================
*.elf
*.bin
*.hex
*.dis

# ==========================================
# 5. OS / エディタ一時ファイル
# ==========================================
.DS_Store
.vscode/
*.swp
*~
*.pyc
__pycache__/
