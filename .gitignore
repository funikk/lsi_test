# ==========================================
# 1. EDAツール本体・PDKs・環境設定 (管理対象外)
# ==========================================
/librelane/
/pdks/
/.tools/

# ==========================================
# 2. PnR (LibreLane) 実行結果
# ==========================================
# 各プロジェクト配下の pnr/ 内の config.json / trial_plan.json 等の設定ファイルは管理対象にし、
# 実行成果物が格納される runs/ および自動生成される configs/ ディレクトリを除外
**/pnr/runs/
**/pnr/configs/
librelane_designs/**/runs/

# ==========================================
# 3. 各プロジェクトのビルド・シミュレーション生成物
# ==========================================
# 波形・ログ・コンパイル済みバイナリ・中間成果物
*.vcd
*.vvp
*.log
*.out
*_gate.v
*_syn.v

# sim/, syn/, gls/ ディレクトリ内の動的生成物
**/sim/*
**/syn/*
**/gls/*

# ==========================================
# 4. ファームウェアビルド生成物
# ==========================================
*.elf
*.bin
*.hex
*.dis

# ==========================================
# 5. OS / エディタ一時ファイル
# ==========================================
.DS_Store
.vscode/
*.swp
*~
*.pyc
__pycache__/
